{
  "entities": {
    "users": {
      "fields": {
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar photo URL"
        },
        "lastActive": {
          "type": "string",
          "description": "ISO timestamp of last activity"
        },
        "starredWordIds": {
          "type": "list",
          "description": "Array of saved/bookmarked vocabulary IDs"
        },
        "masteredWordIds": {
          "type": "list",
          "description": "Array of mastered vocabulary IDs"
        },
        "studyStats": {
          "type": "map",
          "description": "Overall study statistics (totalQuizzes, highestScore, wordsStudied)"
        }
      }
    },
    "users/{userId}/quizHistory": {
      "fields": {
        "score": {
          "type": "number",
          "description": "Correct answers in quiz"
        },
        "total": {
          "type": "number",
          "description": "Total questions attempted"
        },
        "lesson": {
          "type": "string",
          "description": "Lesson selected or all"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO string timestamp"
        }
      }
    },
    "vocabulary": {
      "fields": {
        "id": {
          "type": "number",
          "description": "Numeric identifier for the word"
        },
        "lesson": {
          "type": "number",
          "description": "Lesson number (e.g. 25-34)"
        },
        "word": {
          "type": "string",
          "description": "Japanese word"
        },
        "hanViet": {
          "type": "string",
          "description": "Sino-Vietnamese reading"
        },
        "type": {
          "type": "string",
          "description": "Word type classification"
        },
        "meaning": {
          "type": "string",
          "description": "Vietnamese meaning"
        },
        "example": {
          "type": "string",
          "description": "Example usage sentence"
        }
      }
    },
    "grammar": {
      "fields": {
        "id": {
          "type": "number",
